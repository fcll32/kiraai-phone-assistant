.meta-value { font-size: 14px; color: #2f3438; margin-top: 4px; }
.meta-divider { width: 1px; height: 26px; background-color: #e9eff9; margin: 0 12px; }
.hero-action { margin-top: 16px; }
.cta-wrap { position: relative; border-radius: 30px; }
.connection-feedback { font-size: 13px; line-height: 21px; color: #83502c; margin-top: 10px; }
.cta-halo { pointer-events: none; position: absolute; left: -3px; right: -3px; top: -3px; bottom: -3px; border-radius: 33px; border-style: solid; border-width: 1px; border-color: rgba(124,196,255,0.45); background-color: rgba(124,196,255,0.10); }
.hero-copy { transition-property: transform, opacity; }
.sweep-track { height: 2px; border-radius: 1px; background-color: transparent; overflow: hidden; margin-bottom: 8px; }
.sweep-fill { width: 100%; transform-origin: left center; height: 2px; border-radius: 1px; background-color: #5c96ed; }

.drawer-scrim { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: #14171a; z-index: 44; }
.drawer { transition-property: transform; position: fixed; left: 0; top: 0; bottom: 0; width: 300px; z-index: 45; border-style: solid; border-width: 0 1px 0 0; padding: 28px 18px 22px; flex-direction: column; background-color: #e6efff; border-color: rgba(255,255,255,0.8); box-shadow: 12px 0 40px rgba(27,54,109,0.16); }
.drawer-head { position: relative; flex-shrink: 0; height: 166px; justify-content: flex-end; padding-bottom: 16px; }
.drawer-badge { width: 46px; height: 46px; border-radius: 17px; background-color: #4b7be0; align-items: center; justify-content: center; margin-right: 12px; background-image: linear-gradient(to bottom right,#70caff,#5a77e2); border: 1px solid rgba(255,255,255,0.7); }
.drawer-letter { color: #f0f5fd; font-size: 14px; font-weight: 600; letter-spacing: 1px; }
.drawer-title { font-weight: 600; color: #203f76; font-size: 17px; }
.drawer-sub { font-size: 11px; margin-top: 4px; color: #536b97; }
.drawer-rule { position: relative; flex-shrink: 0; height: 1px; margin: 0 0 12px; background-color: rgba(255,255,255,0.7); }
