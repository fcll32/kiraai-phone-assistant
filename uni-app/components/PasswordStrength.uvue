<template>
  <view v-if="value.length > 0" class="strength" aria-live="polite">
    <view class="strength-bars"><view v-for="i in 4" :key="i" class="strength-cell"><view class="strength-fill" :style="barStyle(i)" /></view></view>
    <view class="strength-row">
      <view class="strength-label-box"><text class="strength-label" :style="labelStyle">强度估计 · {{ label }}</text></view>
      <view class="strength-check" :style="{ opacity: quality.score === 4 ? 1 : 0 }"><view class="strength-stroke-a" :style="strokeStyle(false)" /><view class="strength-stroke-b" :style="strokeStyle(true)" /></view>
    </view>
    <text class="strength-note">只在本机估计；密码仍须与服务器一致。</text>
  </view>
</template>
<script setup>
import { ref, computed, watch, onUnmounted } from 'vue'
import { passwordStrength } from '@/lib/motion.js'
import { createTimeoutScope } from '@/lib/timers.js'
const props = defineProps({ value: { type: String, default: '' }, duration: { type: Number, default: 250 }, active: { type: Boolean, default: true } })
const quality = computed(() => passwordStrength(props.value))
const label = ref(quality.value.label), shift = ref(0), opacity = ref(1), checked = ref(quality.value.score === 4)
const timers = createTimeoutScope()
function settle() { timers.clear(); label.value = quality.value.label; shift.value = 0; opacity.value = 1; checked.value = quality.value.score === 4 }
function update() {
  timers.clear(); checked.value = false
  if (!props.active || !props.duration) { settle(); return }
  shift.value = -7; opacity.value = 0
  timers.after(() => { label.value = quality.value.label; shift.value = 7; timers.after(() => { shift.value = 0; opacity.value = 1; checked.value = quality.value.score === 4 }, 16) }, props.duration / 2)
}
watch(() => quality.value.score, update)
watch(() => [props.active, props.duration], settle)
const labelStyle = computed(() => ({ color: quality.value.color, opacity: opacity.value, transform: 'translateY(' + shift.value + 'px)', transitionDuration: Math.round(props.duration / 2) + 'ms' }))
function barStyle(i) { return { backgroundColor: quality.value.color, transform: 'scaleX(' + (quality.value.score >= i ? 1 : 0) + ')', transitionDuration: props.duration + 'ms', transitionDelay: (props.duration && quality.value.score >= i ? (i - 1) * props.duration * .16 : 0) + 'ms' } }
function strokeStyle(long) { return { transform: 'rotate(' + (long ? -45 : 45) + 'deg) scaleX(' + (checked.value ? 1 : 0) + ')', transitionDuration: Math.round(props.duration * .55) + 'ms', transitionDelay: (long && props.duration ? props.duration * .35 : 0) + 'ms' } }
onUnmounted(() => timers.dispose())
</script>
<style>
.strength { margin-top: 12px; }
.strength-bars { flex-direction: row; height: 4px; }
.strength-cell { flex: 1; height: 4px; border-radius: 3px; margin-right: 5px; background-color: #e1e9ef; overflow: hidden; }
.strength-fill { height: 4px; width: 100%; transform-origin: left center; transition-property: transform,background-color; transition-timing-function: cubic-bezier(0.22,1.2,0.4,1); }
.strength-row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 8px; }
.strength-label-box { height: 19px; overflow: hidden; }
.strength-label { font-size: 12px; transition-property: transform,opacity,color; transition-timing-function: ease-out; }
.strength-note { font-size: 11px; color: #788b9b; margin-top: 3px; line-height: 18px; }
.strength-check { position: relative; width: 20px; height: 18px; }
.strength-stroke-a,.strength-stroke-b { position: absolute; height: 2px; background-color: #43856d; border-radius: 2px; transform-origin: left center; transition-property: transform; }
.strength-stroke-a { left: 1px; top: 9px; width: 6px; }
.strength-stroke-b { left: 5px; top: 13px; width: 13px; }
</style>
