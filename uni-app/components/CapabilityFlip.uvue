<template>
  <view class="capability">
    <view class="flip-card" :style="cardStyle" role="button" :aria-label="back ? '翻回手机能力正面' : '翻开手机能力说明'" @click="flip">
      <view v-show="!back" class="flip-face">
        <text class="flip-kicker">这台手机的能力</text><text class="flip-title">看见 · 操作 · 对话</text>
        <view class="flip-art"><view class="flip-phone"><text class="flip-ai">AI</text><view class="flip-line" /><view class="flip-line flip-short" /></view><view class="flip-orbit" /></view>
        <text class="flip-hint">轻点翻面，了解截图与通话</text>
      </view>
      <view v-show="back" class="flip-face">
        <text class="flip-kicker">由你授权，随时停止</text><text class="flip-title">先了解，再连接</text>
        <text class="flip-copy">Android 11 及以上可按需截图；8–10 提供界面文字和按钮位置。</text>
        <text class="flip-copy">App 内通话需授权麦克风。连接和语音都由你的 Kira 服务器处理。</text>
        <text class="flip-hint">轻点卡片可以翻回</text>
      </view>
    </view>
    <view class="flip-actions" :style="actionsStyle">
      <view role="button" class="flip-button" :aria-disabled="!ready" @click="act('help')"><text class="flip-button-text">查看使用说明</text></view>
      <view role="button" class="flip-button flip-primary" :aria-disabled="!ready" @click="act('connect')"><text class="flip-primary-text">去连接</text></view>
    </view>
  </view>
</template>
<script setup>
import { ref, computed, watch, onUnmounted } from 'vue'
const props = defineProps({ duration: { type: Number, default: 600 } })
const emit = defineEmits(['help', 'connect'])
const angle = ref(0), busy = ref(false)
let target = 0, timer = null
const back = computed(() => angle.value >= 90)
const ready = computed(() => !busy.value && target === 180)
const cardStyle = computed(() => {
  const lift = Math.sin(Math.min(180, Math.max(0, angle.value)) * Math.PI / 180)
  let perspective = ''
  // #ifdef H5
  perspective = 'perspective(900px) '
  // #endif
  return { transform: perspective + 'translateY(' + (-10 * lift) + 'px) rotateY(' + (back.value ? angle.value - 180 : angle.value) + 'deg) scale(' + (1 + lift * 0.05) + ')' }
})
const actionsStyle = computed(() => ({ opacity: ready.value ? 1 : 0, transform: ready.value ? 'translateY(0px)' : 'translateY(14px)', transitionDuration: Math.round(props.duration / 2) + 'ms', pointerEvents: ready.value ? 'auto' : 'none' }))
function stop() { if (timer != null) clearInterval(timer); timer = null }
function flip() {
  if (busy.value) return
  target = target === 0 ? 180 : 0
  const from = angle.value, start = Date.now()
  if (props.duration === 0) { angle.value = target; return }
  busy.value = true
  timer = setInterval(() => {
    const p = Math.min(1, (Date.now() - start) / props.duration)
    const eased = p < 0.85 ? (1 - Math.cos(Math.PI * p / 0.85)) / 2 : 1 + Math.sin((p - 0.85) / 0.15 * Math.PI) * 0.012
    angle.value = from + (target - from) * eased
    if (p === 1) { stop(); angle.value = target; busy.value = false }
  }, 16)
}
function act(name) { if (ready.value) emit(name) }
watch(() => props.duration, () => { if (props.duration === 0) { stop(); angle.value = target; busy.value = false } })
onUnmounted(stop)
</script>
<style>
.capability { margin-top: 24px; }
.flip-card { height: 278px; border-radius: 30px; background-color: #edf5ff; box-shadow: 0 7px 24px rgba(50,75,156,0.12); border: 1px solid rgba(255,255,255,0.8); }
.flip-face { padding: 24px; flex: 1; }
.flip-kicker { font-size: 12px; color: #4b7acc; }
.flip-title { font-weight: 700; color: #22447e; margin-top: 10px; font-size: 21px; }
.flip-copy { margin-top: 18px; font-size: 14px; line-height: 22px; color: #4b6795; }
.flip-hint { font-size: 12px; color: #657f9a; margin-top: 18px; }
.flip-art { height: 125px; align-items: center; justify-content: center; }
.flip-phone { width: 68px; height: 108px; border: 3px solid #537ead; border-radius: 17px; padding: 15px 12px; transform: rotate(12deg); z-index: 1; background-color: #e2efff; }
.flip-ai { font-size: 24px; font-weight: 700; color: #28588e; }
.flip-line { height: 4px; background-color: #91b4df; margin-top: 8px; border-radius: 4px; }
.flip-short { width: 20px; }
.flip-orbit { position: absolute; width: 140px; height: 70px; border: 1px solid #c5d9f1; border-radius: 70px; transform: rotate(-18deg); }
.flip-actions { flex-direction: row; margin-top: 14px; transition-property: transform,opacity; }
.flip-button { flex: 1; height: 44px; border-radius: 16px; justify-content: center; align-items: center; background-color: #dbeaff; }
.flip-primary { margin-left: 10px; background-color: #5384df; background-image: linear-gradient(to bottom right,#62a8ed,#597bd7); }
.flip-button-text {font-size: 13px;  color: #345978; }
.flip-primary-text { font-size: 13px; font-weight: 600; color: #ffffff; }
</style>
