<template>
  <view class="welcome" :style="{ paddingTop: (inset + 26) + 'px' }" @touchstart.stop="start" @touchmove.stop="move" @touchend.stop="end" @touchcancel.stop="cancel">
    <AppBackdrop />
    <view class="welcome-head"><text class="welcome-brand">KiraAI 手机助手</text><text v-if="index < 2" class="welcome-skip" role="button" @click="emit('skip')">暂时跳过</text></view>
    <view class="welcome-window" :style="{ width: width + 'px' }">
      <view v-for="(item, i) in pages" :key="i" class="welcome-page" :aria-hidden="i !== index" :style="pageStyle(i)">
        <view class="welcome-art" :style="artStyle(i)">
          <view class="welcome-halo" /><view class="welcome-device"><text class="welcome-ai">AI</text><view class="welcome-screen-line" /><view class="welcome-screen-line short" /><view class="welcome-screen-dot" /></view>
          <view class="welcome-tag" :style="tagStyle(i)"><text class="welcome-tag-text">{{ item.tag }}</text></view>
        </view>
        <view class="welcome-copy" :style="copyStyle(i)"><text class="welcome-eyebrow">0{{ i + 1 }} / 03</text><text class="welcome-title">{{ item.title }}</text><text class="welcome-body">{{ item.body }}</text></view>
      </view>
    </view>
    <view class="welcome-bottom"><view class="welcome-dots"><view v-for="(item, i) in pages" :key="i" class="welcome-dot" :style="dotStyle(i)" /></view>
      <view class="welcome-button-space">
        <view v-show="finalProgress < 1" class="welcome-next" :aria-hidden="index === 2" :style="{ opacity: 1 - finalProgress }" role="button" aria-label="下一页" @click="next"><text class="welcome-next-text">继续了解 →</text></view>
        <view v-show="finalProgress > 0" class="welcome-next welcome-final" :aria-hidden="index !== 2" :style="{ opacity: finalProgress, transform: 'translateY(' + ((1 - finalProgress) * 60) + 'px)' }" role="button" aria-label="开始使用" @click="next"><text class="welcome-next-text">开始使用</text></view>
      </view>
      <text class="welcome-hint">左右滑动 · 控制和通话都由你手动开始</text>
    </view>
  </view>
</template>
<script setup>
import AppBackdrop from '@/components/AppBackdrop.uvue'
import { ref, computed, watch, onUnmounted } from 'vue'
import { swipePage } from '@/lib/motion.js'
const props = defineProps({ duration: { type: Number, default: 400 }, active: { type: Boolean, default: true }, inset: { type: Number, default: 24 } })
const emit = defineEmits(['finish', 'skip'])
const width = Math.max(280, uni.getWindowInfo().windowWidth), index = ref(0), position = ref(0), settling = ref(false)
const artHeight = uni.getWindowInfo().windowHeight < 700 ? 150 : 205
const finalProgress = computed(() => Math.max(0, Math.min(1, position.value - 1)))
const pages = [
  { tag: '自己的服务器', title: '给 Kira 一台手机', body: '手机主动连接你的 Kira 服务器。公网入口默认 5267，填好地址、密码和校验码就能准备连接。' },
  { tag: '按需观察', title: '看得见，才操作', body: '文字和按钮先读界面信息，图片和视频按需截图。Android 8–10 提供界面信息，11 及以上还能截图。' },
  { tag: '由你掌控', title: '每次连接，由你决定', body: '开启无障碍后手动开始连接，只允许指定聊天操作。需要语音时再授权麦克风，你随时可以停止。' }
]
let timer = null, dragging = false, axis = 0, x = 0, y = 0, origin = 0, last = 0, at = 0, velocity = 0, target = 0
function stop() { if (timer != null) clearInterval(timer); timer = null }
function finish() { stop(); index.value = target; position.value = target; settling.value = false; dragging = false }
function go(value) {
  target = Math.max(0, Math.min(2, value)); stop(); dragging = false
  const from = position.value, began = Date.now()
  if (!props.duration || !props.active || Math.abs(from - target) < .001) { finish(); return }
  settling.value = true
  timer = setInterval(() => { const p = Math.min(1, (Date.now() - began) / props.duration); position.value = target + (from - target) * Math.exp(-7 * p) * Math.cos(5 * p); if (p === 1) finish() }, 16)
}
function start(e) { if (!props.active) return; stop(); settling.value = false; dragging = true; axis = 0; x = last = e.touches[0].clientX; y = e.touches[0].clientY; at = Date.now(); velocity = 0; origin = position.value }
function move(e) { if (!dragging) return; const next = e.touches[0].clientX, dx = next - x, dy = e.touches[0].clientY - y; if (!axis && Math.max(Math.abs(dx), Math.abs(dy)) > 6) axis = Math.abs(dx) > Math.abs(dy) ? 1 : 2; if (axis !== 1) return; const now = Date.now(); velocity = (last - next) / Math.max(8, now - at); last = next; at = now; let value = origin - dx / width; if (value < 0) value *= .2; if (value > 2) value = 2 + (value - 2) * .2; position.value = value }
function end() { if (!dragging) return; dragging = false; if (axis !== 1) { go(index.value); return }; const delta = position.value - origin; let value = swipePage(position.value, velocity, width, 3, Date.now() - at); if (Math.abs(delta) >= 1 / 3) value = index.value + Math.sign(delta); go(value) }
function cancel() { velocity = 0; go(index.value) }
function next() { if (settling.value || dragging || !props.active) return; if (index.value === 2) emit('finish'); else go(index.value + 1) }
function pageStyle(i) { return { width: width + 'px', transform: 'translateX(' + ((i - position.value) * width) + 'px)' } }
function artStyle(i) { const d = i - position.value; return { height: artHeight + 'px', marginBottom: (artHeight < 205 ? 16 : 30) + 'px', transform: 'translateX(' + (-d * 35) + 'px) scale(' + ((artHeight / 205) * (1 - Math.min(1, Math.abs(d)) * .12)) + ')', opacity: 1 - Math.min(1, Math.abs(d)) * .55 } }
function copyStyle(i) { const d = i - position.value; return { transform: 'translateX(' + (d * 20) + 'px)', opacity: 1 - Math.min(1, Math.abs(d)) * .8 } }
function tagStyle(i) { return { transform: 'translateX(' + ((i - position.value) * -22) + 'px)' } }
function dotStyle(i) { const amount = 1 - Math.min(1, Math.abs(position.value - i)); return { width: (8 + amount * 20) + 'px', opacity: .3 + amount * .7 } }
watch(() => [props.active, props.duration], () => { if (!props.active || !props.duration) finish() })
onUnmounted(stop)
</script>
<style>
.welcome { position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 90; background-color: #dceaff; }
.welcome-head { padding: 0 26px; flex-direction: row; align-items: center; justify-content: space-between; position: relative; }
.welcome-brand { font-size: 14px; color: #31548a; }
.welcome-skip { padding: 10px 0 10px 14px; color: #73899a; font-size: 13px; }
.welcome-window { flex: 1; position: relative; overflow: hidden; min-height: 260px; }
.welcome-page { position: absolute; top: 0; bottom: 0; left: 0; padding: 0 28px; justify-content: center; }
.welcome-art { height: 205px; align-items: center; justify-content: center; margin-bottom: 30px; }
.welcome-halo { position: absolute; width: 202px; height: 202px; border-radius: 101px; background-color: rgba(225,241,255,0.7); border: 1px solid rgba(255,255,255,0.8); }
.welcome-device { width: 96px; height: 151px; border: 3px solid #6788a0; border-radius: 24px; padding: 20px 16px; background-color: #eef7ff; transform: rotate(-8deg); border-color: #8bb5f0; box-shadow: 0 8px 28px rgba(63,92,174,0.18); }
.welcome-ai { font-size: 28px; color: #466c8b; font-weight: 600; }
.welcome-screen-line { height: 5px; border-radius: 3px; margin-top: 12px; background-color: #c0d3df; }
.short { width: 32px; }
.welcome-screen-dot { width: 12px; height: 12px; border-radius: 6px; background-color: #6d9c88; margin-top: 17px; }
.welcome-tag { position: absolute; bottom: 6px; right: 16px; padding: 10px 15px; background-color: #ffffff; border: 1px solid #d7e3ea; border-radius: 20px; }
.welcome-tag-text { font-size: 12px; color: #4b748c; }
.welcome-copy { align-items: center; padding: 20px 16px; border-radius: 26px; background-color: rgba(244,250,255,0.83); border: 1px solid rgba(255,255,255,0.8); }
.welcome-eyebrow { font-size: 11px; color: #7893a5; margin-bottom: 12px; }
.welcome-title { color: #264878; font-size: 25px; font-weight: 700; text-align: center; margin-bottom: 16px; }
.welcome-body { color: #4c6590; font-size: 14px; line-height: 23px; text-align: center; }
.welcome-bottom { padding: 10px 28px 30px; position: relative; }
.welcome-dots { flex-direction: row; justify-content: center; margin-bottom: 22px; }
.welcome-dot { height: 7px; border-radius: 4px; background-color: #5887d8; margin: 0 4px; }
.welcome-button-space { position: relative; height: 52px; overflow: hidden; }
.welcome-next { position: absolute; left: 0; right: 0; top: 0; height: 52px; border-radius: 26px; align-items: center; justify-content: center; background-color: #5486e1; background-image: linear-gradient(to bottom right,#66b7f2,#607dda); border: 1px solid rgba(255,255,255,0.8); }
.welcome-final { background-color: #4c7bda; }
.welcome-next-text { color: #ffffff; font-size: 15px; font-weight: 600; }
.welcome-hint { margin-top: 13px; font-size: 11px; text-align: center; color: #496591; }
</style>
