<template>
  <view class="deck-module">
  <view class="deck-segments" role="tablist">
    <view class="deck-underline" :style="underlineStyle" />
    <view v-for="(card, i) in cards" :key="i" class="deck-segment" role="tab" :aria-selected="current === i" @click="pick(i)"><text :style="segmentStyle(i)">{{ checks[i] ? '✓ ' : '' }}{{ card.short }}</text></view>
  </view>
  <view class="deck" :style="{ height: (height - 42) + 'px' }"
    @touchstart.stop="onStart" @touchmove.stop="onMove" @touchend.stop="onEnd" @touchcancel.stop="onCancel">
    <view v-for="(card, i) in cards" :key="i" class="deck-card" :class="i === current ? 'deck-card-active' : ''" :style="cardStyle(i)" @click="onSelect(i, $event)">
      <view v-if="pressed && i === current" class="deck-glint" :style="{ transform: 'translateX(' + glintX + 'px) translateY(' + glintY + 'px)' }" />
      <view class="deck-top">
        <view class="deck-no"><text class="deck-no-text">0{{ i + 1 }}</text></view>
        <text class="deck-state" :class="checks[i] ? 'deck-done' : ''">{{ checks[i] ? '已完成' : '待完成' }}</text>
      </view>
      <text class="deck-title">{{ card.title }}</text>
      <text class="deck-desc">{{ card.description }}</text>
      <view class="deck-action"><text class="deck-link">{{ card.action }} →</text></view>
    </view>
  </view>
  <view class="deck-dots"><view v-for="(card, i) in cards" :key="i" class="deck-dot" :style="dotStyle(i)" /></view>
  </view>
</template>

<script setup>
import { ref, computed, onUnmounted } from 'vue'
const props = defineProps({
  cards: { type: Array, default: () => [] },
  checks: { type: Array, default: () => [] },
  current: { type: Number, default: 0 },
  width: { type: Number, default: 346 },
  height: { type: Number, default: 188 },
  duration: { type: Number, default: 320 }
})
const emit = defineEmits(['change', 'select', 'grab'])
const ratio = ref(0)
const dragging = ref(false)
const settling = ref(false)
const lean = ref(0)
const liquidX = ref(1)
const liquidY = ref(1)
const pressed = ref(false), tiltX = ref(0), tiltY = ref(0), glintX = ref(0), glintY = ref(0)
let selectTimer = null, pressLeft = 20, pressTop = 0, originRatio = 0
let startX = 0, startY = 0, axis = 0, touched = false, lastX = 0, lastTime = 0
let spring = null, velocity = 0
const gap = computed(() => props.width - 40)
const live = computed(() => dragging.value || settling.value)
const position = computed(() => props.current - ratio.value)
const underlineStyle = computed(() => {
  const p = Math.max(0, Math.min(props.cards.length - 1, position.value)), fraction = p - Math.floor(p)
  const cell = props.width / Math.max(1, props.cards.length), worm = Math.sin(fraction * Math.PI) * cell * 0.45
  return { width: '28px', transform: 'translateX(' + (p * cell + (cell - 28) / 2 - worm / 2) + 'px) scaleX(' + (1 + worm / 28) + ')' }
})
function segmentStyle(i) { const amount = 1 - Math.min(1, Math.abs(position.value - i)); return { color: 'rgb(' + Math.round(103 - amount * 54) + ',' + Math.round(125 - amount * 42) + ',' + Math.round(145 - amount * 34) + ')', fontWeight: '600', fontSize: '13px' } }
function dotStyle(i) { const amount = 1 - Math.min(1, Math.abs(position.value - i)); return { transform: 'scaleX(' + (1 + amount * 1.5) + ')', opacity: 0.3 + amount * 0.7 } }
function pick(i) { touched = true; pressed.value = false; if (selectTimer != null) clearTimeout(selectTimer); settle(i - props.current); emit('grab') }
function tilt(touch) {
  if (props.duration === 0) return
  const x = Math.max(-1, Math.min(1, (touch.clientX - pressLeft) / (props.width - 52) * 2 - 1))
  const y = Math.max(-1, Math.min(1, (touch.clientY - pressTop) / 180 * 2 - 1))
  tiltY.value = -x * 8; tiltX.value = y * 8
  glintX.value = (x + 1) * (props.width - 52) / 2 - 70; glintY.value = (y + 1) * 90 - 70
}

function cardStyle(index) {
  const distance = index - props.current + ratio.value
  const active = index === props.current
  const depth = Math.min(Math.abs(distance), 2)
  // 3D 视差：后排卡片更小、更淡，形成景深层次
  const scale = (1 - Math.min(depth, 1) * 0.12) * (active && pressed.value && props.duration > 0 ? 0.97 : 1)
  const sx = active ? scale * liquidX.value : scale
  const sy = active ? scale * liquidY.value : scale
  let perspective = ''
  // #ifdef H5
  perspective = 'perspective(800px) '
  // #endif
  return {
    left: '26px',
    width: (props.width - 52) + 'px',
    transform: perspective + 'translateX(' + (distance * gap.value) + 'px) rotateX(' + (active && pressed.value ? tiltX.value : 0) + 'deg) rotateY(' + (active && pressed.value ? tiltY.value : 0) + 'deg) scaleX(' + sx + ') scaleY(' + sy + ')',
    opacity: 1 - Math.min(Math.abs(distance), 1) * 0.2,
    zIndex: active ? 20 : 10,
    transitionDuration: live.value ? '0ms' : Math.round(props.duration * 400 / 320) + 'ms',
    transitionTimingFunction: 'cubic-bezier(0.24,1.32,0.36,1)'
  }
}
function onStart(event) {
  const touch = event.touches[0]
  if (selectTimer != null) { clearTimeout(selectTimer); selectTimer = null }
  if (spring != null) { clearInterval(spring); spring = null }
  settling.value = false
  startX = touch.clientX; startY = touch.clientY
  lastX = startX; lastTime = Date.now()
  originRatio = ratio.value; axis = 0; dragging.value = true; touched = false; velocity = 0
  const rect = event.currentTarget && event.currentTarget.getBoundingClientRect ? event.currentTarget.getBoundingClientRect() : null
  pressLeft = rect ? rect.left + 26 : 46; pressTop = rect ? rect.top : touch.clientY - 90
  pressed.value = true; tilt(touch)
  emit('grab')
  lean.value = 0; liquidX.value = 1; liquidY.value = 1
}
function onMove(event) {
  if (!dragging.value) return
  const touch = event.touches[0]
  const dx = touch.clientX - startX, dy = touch.clientY - startY
  tilt(touch)
  if (axis === 0 && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) axis = Math.abs(dx) >= Math.abs(dy) ? 1 : 2
  if (Math.abs(dx) > 6 || Math.abs(dy) > 6) touched = true
  if (axis !== 1) return
  touched = true
  const span = gap.value
  let next = originRatio + dx / span
  const maxLeft = props.current - props.cards.length + 1, maxRight = props.current
  // 物理碰撞：越过边界后阻力增大，松手回弹
  if (next < maxLeft) next = maxLeft + (next - maxLeft) * 0.3
  if (next > maxRight) next = maxRight + (next - maxRight) * 0.3
  ratio.value = next
  const now = Date.now()
  const dt = Math.max(8, now - lastTime)
  velocity = (touch.clientX - lastX) / dt
  lastX = touch.clientX; lastTime = now
  // 液态形变：速度越快拉伸越明显，方向相反以产生惯性拖尾
  const amp = Math.min(0.17, Math.abs(velocity) * 0.24)
  liquidX.value = 1 + amp
  liquidY.value = 1 - amp * 0.62
  lean.value = Math.max(-6, Math.min(6, velocity * 6))
}
function onEnd() {
  if (!dragging.value) return
  dragging.value = false
  pressed.value = false
  if (axis !== 1) { if (ratio.value !== 0) settle(0); return }
  const moved = ratio.value
  if (Date.now() - lastTime > 90) velocity = 0
  let target = Math.round(-moved - velocity * 140 / gap.value)
  const maxLeft = -props.current, maxRight = props.cards.length - 1 - props.current
  target = Math.max(maxLeft, Math.min(maxRight, target))
  settle(target)
}
function settle(target) {
  if (spring != null) { clearInterval(spring); spring = null }
  const from = ratio.value
  const destination = -target
  const distance = destination - from
  const start = Date.now()
  const span = props.duration * 400 / 320
  settling.value = true
  if (props.duration === 0) {
    ratio.value = 0; settling.value = false
    lean.value = 0; liquidX.value = 1; liquidY.value = 1
    if (target !== 0) emit('change', props.current + target)
    return
  }
  spring = setInterval(() => {
    const p = Math.min(1, (Date.now() - start) / span)
    // 磁吸：越接近目标加速度越高，末端保留一点回弹
    ratio.value = destination - distance * Math.exp(-6.4 * p) * Math.cos(p * Math.PI * 1.5)
    lean.value = lean.value * 0.9
    liquidX.value = 1 + (liquidX.value - 1) * 0.9
    liquidY.value = 1 + (liquidY.value - 1) * 0.9
    if (p >= 1) {
      clearInterval(spring); spring = null
      ratio.value = 0
      lean.value = 0; liquidX.value = 1; liquidY.value = 1
      settling.value = false
      if (target !== 0) emit('change', props.current + target)
    }
  }, 16)
}
function onCancel() { touched = true; pressed.value = false; dragging.value = false; velocity = 0; settle(0) }
function onSelect(index, event) {
  if (touched || settling.value || index !== props.current) return
  // Measure in this component before mounting the overlay. A parent selector
  // may not cross native component boundaries and used to flash a full panel.
  const element = event ? event.currentTarget : null
  const rect = element ? element.getBoundingClientRect() : null
  if (selectTimer != null) clearTimeout(selectTimer)
  const publish = () => { selectTimer = null; if (!touched && index === props.current) emit('select', { index, rect }) }
  if (props.duration === 0) publish()
  else selectTimer = setTimeout(publish, props.duration * 100 / 320)
}
onUnmounted(() => { if (spring != null) clearInterval(spring); if (selectTimer != null) clearTimeout(selectTimer) })
</script>

<style>
.deck { position: relative; overflow: hidden; }
.deck-segments { position: relative; height: 42px; flex-direction: row; margin-bottom: 12px; }
.deck-segment { flex: 1; align-items: center; justify-content: center; padding-bottom: 8px; }
.deck-underline {position: absolute; left: 0; bottom: 0; height: 3px; border-radius: 4px;  transform-origin: left center;  background-color: #6687a8; }
.deck-dots { height: 16px; flex-direction: row; justify-content: center; align-items: center; }
.deck-dot {width: 5px; height: 5px; border-radius: 4px;  margin: 0 7px;  background-color: #6687a8; }
.deck-glint { position: absolute; left: 0; top: 0; width: 140px; height: 140px; border-radius: 70px; background-color: rgba(163,202,255,0.14); pointer-events: none; }
.deck-card {position: absolute; top: 0; left: 0; right: 0; height: 180px; padding: 20px; border-radius: 20px; border-style: solid; border-width: 1px;   transition-property: transform,opacity; transition-timing-function: cubic-bezier(0.22,0.8,0.3,1);  background-color: #f8fafb; border-color: #d4e0ea; }
.deck-card-active {border-color: #c7dcf2;   background-color: #f8fafb; }
.deck-top { flex-direction: row; align-items: center; justify-content: space-between; }
.deck-no {width: 30px; height: 30px; border-radius: 9px;  align-items: center; justify-content: center;  background-color: #e3edf5; }
.deck-no-text { font-size: 11px; font-weight: 600; color: #1e63b4; }
.deck-state { font-size: 11px; color: #555c62; }
.deck-done { color: #12805d; }
.deck-title {margin-top: 12px;  font-weight: 600;   font-size: 17px; color: #29465f; }
.deck-desc {margin-top: 7px; font-size: 13px; line-height: 20px;   color: #62788b; }
.deck-action { position: absolute; left: 20px; bottom: 12px; }
.deck-link { font-size: 14px; color: #1e63b4; font-weight: 400; }
</style>
