<template>
  <view class="nav-dock">
  <view class="liquid-nav" role="tablist">
    <GlassSurface :radius="28" :sdk="sdk" :active="active && interactive" :blurred="phase >= 1" />
    <view v-if="selected >= 0" class="liquid-pill" :style="pillStyle" />
    <view v-for="(tab, i) in items" :key="tab.id" class="liquid-tab" role="tab" :aria-selected="page === tab.id" :aria-label="tab.label" @click="select(tab.id)">
      <view class="liquid-icon" :style="iconStyle(i)" aria-hidden="true">
        <image class="nav-companion" :src="'/static/companions/' + tab.sticker + '.png'" mode="aspectFit" :style="{ opacity: selected === i ? 1 : 0.72, transitionDuration: duration + 'ms' }" />
      </view>
      <text class="liquid-label" :style="labelStyle(i)">{{ tab.label }}</text>
    </view>
  </view>
  </view>
</template>
<script setup>
import { ref, computed, watch, onUnmounted } from 'vue'
import GlassSurface from '@/components/GlassSurface.uvue'
const props = defineProps({ page: { type: Number, default: 0 }, width: { type: Number, default: 370 }, duration: { type: Number, default: 400 }, sdk: { type: Number, default: 30 }, active: { type: Boolean, default: true }, interactive: { type: Boolean, default: true } })
const emit = defineEmits(['change'])
function select(id) { if (props.active && props.interactive && items.some(tab => tab.id === id)) emit('change', id) }
const items = [{ id: 0, label: '设备', sticker: 'device' }, { id: 1, label: '连接', sticker: 'link' }, { id: 4, label: '通话', sticker: 'call' }]
const selected = computed(() => items.findIndex(t => t.id === props.page))
const head = ref(Math.max(0, selected.value)), tail = ref(head.value), phase = ref(1)
let timer = null
let lastDestination = Math.max(0, selected.value)
const cell = computed(() => Math.max(0, props.width) / items.length)
const pillStyle = computed(() => {
  // Retain the spring and delayed tail, but never let edge overshoot leave the dock.
  const h = Math.max(0, Math.min(items.length - 1, head.value))
  const t = Math.max(0, Math.min(items.length - 1, tail.value))
  const width = Math.max(1, cell.value - 12)
  return { width: width + 'px', transform: 'translateX(' + (Math.min(h, t) * cell.value + 6) + 'px) scaleX(' + (1 + Math.abs(h - t) * cell.value / width) + ') scaleY(' + (1 - Math.min(0.12, Math.abs(h - t) * 0.1)) + ')' }
})
function labelStyle(i) { return { color: selected.value === i ? '#285bb0' : '#4a648c', transitionDuration: props.duration + 'ms' } }
function iconStyle(i) { return { ...labelStyle(i), transform: 'scale(' + (selected.value === i ? 1 - 0.24 * Math.sin(phase.value * Math.PI * 2) * (1 - phase.value) : 1) + ')' } }
function stop() { if (timer != null) clearInterval(timer); timer = null }
watch(() => [props.page, props.duration, props.active], () => {
  stop()
  const target = selected.value
  if (target < 0) { head.value = lastDestination; tail.value = lastDestination; phase.value = 1; return }
  lastDestination = target
  const fromH = head.value, fromT = tail.value, start = Date.now()
  if (!props.active || props.duration === 0 || (Math.abs(fromH - target) < .001 && Math.abs(fromT - target) < .001)) { head.value = target; tail.value = target; phase.value = 1; return }
  timer = setInterval(() => {
    const p = Math.min(1, (Date.now() - start) / props.duration)
    phase.value = p
    const lead = Math.min(1, p * 1.3), follow = Math.max(0, (p - 0.13) / 0.87)
    head.value = target + (fromH - target) * Math.exp(-7 * lead) * Math.cos(5 * lead)
    tail.value = target + (fromT - target) * Math.exp(-7 * follow) * Math.cos(5 * follow)
    if (p === 1) { stop(); head.value = target; tail.value = target }
  }, 16)
})
onUnmounted(stop)
</script>
<style>
.nav-dock { flex-direction: row; flex-shrink: 0; height: 76px; margin: 0 10px; }
.liquid-nav { position: relative; height: 76px; flex: 1; border-radius: 28px; flex-direction: row; box-shadow: 0 6px 22px rgba(56,75,153,0.14); }
.liquid-pill { position: absolute; left: 0; top: 8px; height: 60px; border-radius: 23px; border: 1px solid rgba(255,255,255,0.86); transform-origin: left center; pointer-events: none; background-color: rgba(181,213,255,0.48); background-image: linear-gradient(to bottom,rgba(255,255,255,0.42),rgba(166,204,255,0.20)); box-shadow: 0 2px 8px rgba(61,99,178,0.08); }
.liquid-tab { flex: 1; align-items: center; justify-content: center; }
.liquid-icon { height: 42px; width: 42px; justify-content: center; align-items: center; pointer-events: none; }
.nav-companion { width: 40px; height: 40px; pointer-events: none; transition-property: opacity; }
.liquid-label { margin-top: 1px; font-size: 12px; line-height: 16px; font-weight: 600; transition-property: color; }
</style>
