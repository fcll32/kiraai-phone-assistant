<template>
  <view class="liquid-nav" role="tablist">
    <view v-if="selected >= 0" class="liquid-pill" :style="pillStyle" />
    <view v-for="(tab, i) in items" :key="tab.id" class="liquid-tab" role="tab" :aria-selected="page === tab.id" :aria-label="tab.label" @click="emit('change', tab.id)">
      <text class="liquid-icon" :style="iconStyle(i)">{{ tab.icon }}</text>
      <text class="liquid-label" :style="labelStyle(i)">{{ tab.label }}</text>
    </view>
  </view>
</template>
<script setup>
import { ref, computed, watch, onUnmounted } from 'vue'
const props = defineProps({ page: { type: Number, default: 0 }, width: { type: Number, default: 370 }, duration: { type: Number, default: 400 } })
const emit = defineEmits(['change'])
const items = [{ id: 0, label: '设备', icon: '▣' }, { id: 1, label: '连接', icon: '⇄' }, { id: 4, label: '通话', icon: '◖' }, { id: 2, label: '偏好', icon: '◎' }]
const selected = computed(() => items.findIndex(t => t.id === props.page))
const head = ref(Math.max(0, selected.value)), tail = ref(head.value), phase = ref(1)
let timer = null
const cell = computed(() => props.width / 4)
const pillStyle = computed(() => ({ width: Math.max(44, cell.value - 12) + 'px', transform: 'translateX(' + (Math.min(head.value, tail.value) * cell.value + 6) + 'px) scaleX(' + (1 + Math.abs(head.value - tail.value) * cell.value / Math.max(44, cell.value - 12)) + ') scaleY(' + (1 - Math.min(0.12, Math.abs(head.value - tail.value) * 0.1)) + ')' }))
function labelStyle(i) { return { color: selected.value === i ? '#294d70' : '#647c91', transitionDuration: props.duration + 'ms' } }
function iconStyle(i) { return { ...labelStyle(i), transform: 'scale(' + (selected.value === i ? 1 - 0.24 * Math.sin(phase.value * Math.PI * 2) * (1 - phase.value) : 1) + ')' } }
function stop() { if (timer != null) clearInterval(timer); timer = null }
watch(() => [props.page, props.duration], () => {
  stop()
  const target = selected.value
  if (target < 0) return
  const fromH = head.value, fromT = tail.value, start = Date.now()
  if (props.duration === 0) { head.value = target; tail.value = target; phase.value = 1; return }
  timer = setInterval(() => {
    const p = Math.min(1, (Date.now() - start) / props.duration)
    phase.value = p
    const lead = Math.min(1, p * 1.3), follow = Math.max(0, (p - 0.13) / 0.87)
    head.value = target + (fromH - target) * Math.exp(-7 * lead) * Math.cos(5 * lead)
    tail.value = target + (fromT - target) * Math.exp(-7 * follow) * Math.cos(5 * follow)
    if (p === 1) { stop(); head.value = target; tail.value = target }
  }, 16)
})
onUnmounted(stop)
</script>
<style>
.liquid-nav {position: relative; height: 68px; margin: 0 10px; flex-direction: row; flex-shrink: 0;   border-top: 1px solid #d3dfe8; background-color: #e9eef2; }
.liquid-pill {position: absolute; left: 0; top: 8px; height: 52px; border-radius: 28px;  transform-origin: left center; pointer-events: none;  background-color: #d0e0ed; }
.liquid-tab { flex: 1; align-items: center; justify-content: center; }
.liquid-icon { font-size: 24px; line-height: 27px; transition-property: color; }
.liquid-label { margin-top: 2px; font-size: 11px; font-weight: 600; transition-property: color; }
</style>
